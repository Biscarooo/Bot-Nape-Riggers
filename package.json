{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Bot de Discord para tocar música e sons a partir de links (YouTube, Spotify, SoundCloud e arquivos diretos)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy": "node src/deploy-commands.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.1.1",
    "play-dl": "^1.9.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
